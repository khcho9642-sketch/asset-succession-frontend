# Server only. Never use NEXT_PUBLIC_ for these values.
# No key is needed for the explicitly labelled direct intake/report flow.
# Synthetic-only Gemini trial. Configure ONLY Preview + codex/ai-conversation-trial.
# VERCEL_ENV and VERCEL_GIT_COMMIT_REF are supplied by Vercel, never spoof locally.
# Use an existing Google Free Tier project, without enabling billing.
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_DIAGNOSIS_MODEL=gemini-3.5-flash-lite
AI_DIAGNOSIS_FREE_TRIAL_ENABLED=false

# Public asset360 AI: Production + main, using the existing Free Tier project
# key and model above as Production-only secrets/config. Do not enable billing.
# Production uses GOOGLE_DIAGNOSIS_MODEL=gemini-3.1-flash-lite after 3.5 service errors.
# This is independent of the protected Preview trial switch.
AI_DIAGNOSIS_PRODUCTION_ENABLED=false

# Server-only consultation intake. Reuse the existing Google Apps Script web app.
# Set these as Production secrets in Vercel; do not give previews production access.
CONSULTATION_WEBHOOK_URL=
CONSULTATION_WEBHOOK_TOKEN=
