# Server only. Never use NEXT_PUBLIC_ for these values.
# No key is needed for the explicitly labelled guided intake/report flow.
AI_GATEWAY_API_KEY=
# Set a provider/model identifier supported by the existing AI Gateway account.
AI_DIAGNOSIS_MODEL=

# Customer-server tax MCP. Never use NEXT_PUBLIC_ for these values.
# Existing authenticated HTTPS endpoint only; no automatic public tunnel.
TAX_MCP_URL=
TAX_MCP_BEARER_TOKEN=
# Local development only. Disabled on Vercel; paths are not deployed.
TAX_MCP_STDIO_COMMAND=
TAX_MCP_STDIO_SCRIPT=
LAW_API_OC=
