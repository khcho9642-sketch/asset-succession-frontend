     \r\n            var frm = document.frm;\r\n            var param = '?gubun=' + gubun.value;                              \r\n            frm.action = \"/rel/information/min/MinListAction.work\"+param+\";jsessionid=d0J3xg7a21O5I24o7J8vnuM58WRqiGPGwwLwvs8Q9U2EZXSuTgDQJNK7HUUVJJac.BJEUWS04_servlet_DCWWW\";\r\n            //if(frm.pageIndex.value==\"\") document.frm.pageIndex.value = \"1\";\r\n            document.frm.pageIndex.value = \"1\";\r\n            frm.submit();           \r\n        }\r\n        \r\n        \r\n        function gubun_list(gubun){             \r\n            var frm = document.frm;\r\n            var param = '?gubun=' + gubun;                            \r\n            frm.action = \"/rel/information/min/MinListAction.work\"+param+\";jsessionid=d0J3xg7a21O5I24o7J8vnuM58WRqiGPGwwLwvs8Q9U2EZXSuTgDQJNK7HUUVJJac.BJEUWS04_servlet_DCWWW\";\r\n            document.frm.pageIndex.value = \"1\";\r\n            frm.submit();           \r\n        }\r\n        \r\n        $(document).ready(function(){\r\n               $(\".s\"+ \"\").css(\"color\",\"red\");                   \r\n        });\r\n     \r\n      \r\n        \r\n        \r\n       \r\n \r\n"
