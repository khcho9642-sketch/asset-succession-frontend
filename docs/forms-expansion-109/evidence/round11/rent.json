ght=980, modal=yes');\r\n\t}\r\n\t\r\n\t \r\n</script>\r\n\r\n<!-- 상단 -->\r\n<div id=\"header\">\r\n\t<div class=\"inr\">\r\n\t\t<h1><a href=\"/webportal/main/portalMainList.open\" class=\"sp-ico logo\" title=\"바로가기\"><em class=\"hide\">등록민간임대주택 렌트홈</em></a></h1>\r\n\t\t<ul class=\"top-menu\">\r\n\t\t\t<li><a href=\"/webportal/main/portalMainList.open\" title=\"홈 바로가기\">홈</a></li>\r\n\t\t\t\r\n\t\t\t\t\t\r\n\t\t\t\t<li><span class=\"bar\"></span><a href=\"/webportal/usr/login/memberLogin.open\" title=\"로그인 바로가기\" class=\"bold color-blue\">로그인</a></li>\r\n\t\t\t\t<li><span class=\"bar\"></span><a href=\"/webportal/common/swInstallViewTop.open\" title=\"프로그램 설치안내 바로가기\" >프로그램 설치안내 </a></li>\r\n\t\t\t\t<li><span class=\"bar\"></span><a href=\"/webportal/siteMap/siteMapView.open\" title=\"사이트맵 바로가기\" class=\"bold color-black\">사이트맵</a></li>\r\n\t\t\t\r\n\t\t\t<li><span class=\"text bold color-gray666\">확대</span><button class=\"btn plus\" onclick=\"zoomIn()\"><i><em class=\"hide\">확대하기</em></i>+</button><button class=\"btn minus\" onclick=\"zoomOut()\"><i><em class=\"hide\">축소하기</em></i>-</button></li>\r\n\t\t</ul>\r\n\t\t<div id=\"nav\">\r\n\t\t\t<ul>\r\n\t\t\t</ul>\r\n\t\t</div>\r\n\t</div>\r\n</div>\r\n<!-- //상단 -->\n\t\t<!-- content_container -->\n\t\t<div id=\"container\">\n\t\t\t\r\n\r\n\r\n<script type=\"text/javascript\">\r\n\t\r\n\tvar gPathName = $(location).attr(\"pathname\");\r\n\t\r\n\t$(document).ready(function(){\r\n\t\t\t$.ajax({\r\n\t\t\t\turl: '/webportal/main/selectLeftMenuList.open',\r\n\t\t\t\tdata: JSON.stringify({\r\n\t\t\t\t\turl: gPathName\r\n\t\t\t\t}),\r\n\t\t\t\tsuccess: function(res) {\r\n\t\t\t\t\tvar str = \"\";\r\n\t\t\t\t\t$.each(res, function( index, value ) {\r\n\t\t\t\t\t\tif(value.level == 1){\r\n\t\t\t\t\t\t\tstr = \"\";\r\n\t\t\t\t\t\t\tstr += \"<p><span>\"+value.menuNm+\"</span></p>\";\r\n\t\t\t\t\t\t\tstr += \"<ul>\";\r\n\t\t\t\t\t\t\tstr += \"</ul>\";\r\n\t\t\t\t\t\t\t$(\".lnb\").append(str);\r\n\t\t\t\t\t\t}else if(value.level == 2 && value.usAt == 'Y'){\r\n\t\t\t\t\t\t\tstr = \"\";\r\n\t\t\t\t\t\t\tstr += \"<li id='menu\"+value.menuSn+\"'>\";\r\n\t\t\t\t\t\t\tif(value.menuBsUrlAdrs != null && value.menuBsUrlAdrs != \"\"){\r\n\t\t\t\t\t\t\t\tif(value.menuBsUrlAdrs==\"/webportal/cont/ilgActStmntView.open\"){\r\n\t\t\t\t\t\t\t\t\tstr += \"<a href=\\\"\"+value.menuBsUrlAdrs+\"\\\" style='letter-spacing: -3px;'>\"+value.menuNm+\"</a>\";\r\n\t\t\t\t\t\t\t\t}else if(value.menuBsUrlAdrs == \"/webportal/bbs/rntgtnUngvbkRntBizmn/selectPbRntgtnUngvbkRntBizmnList.open\"){\r\n\t\t\t\t\t\t\t\t\tstr += \"<a href=\\\"\"+value.menuBsUrlAdrs+\"\\\" style='letter-spacing: -4px;'>\"+value.menuNm+\"</a>\";\r\n\t\t\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\t\t\tstr += \"<a href=\\\"\"+value.menuBsUrlAdrs+\"\\\">\"+value.menuNm+\"</a>\";\t\r\n\t\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\t\tstr += \"<a href=\\\"#\\\" title=\\\"바로가기\\\">\"+value.menuNm+\"</a>\";\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\tif(value.grp == 1){\r\n\t\t\t\t\t\t\t\tstr += \"<ul>\";\r\n\t\t\t\t\t\t\t\tstr += \"</ul>\";\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\tstr += \"</li>\";\r\n\t\t\t\t\t\t\t$(\".lnb > ul\").append(str);\r\n\t\t\t\t\t\t\tif(value.grp != 1 && value.menuBsUrlAdrs == gPathName) {\r\n\t\t\t\t\t\t\t\t$(\"#menu\" + value.menuSn).addClass('on');\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}else if(value.level == 3){\r\n\t\t\t\t\t\t\tif(value.usAt == 'Y'){\r\n\t\t\t\t\t\t\tstr = \"\";\r\n\t\t\t\t\t\t\t\tif(value.menuBsUrlAdrs == gPathName) {\r\n\t\t\t\t\t\t\t\t\tstr += \"<li id='menu\"+value.menuSn+\"' class='on'>\";\r\n\t\t\t\t\t\t\t\t\t$(\"#menu\" + value.upprMenuSn).find('a').eq(0).addClass('on');\r\n\t\t\t\t\t\t\t\t\t$(\"#menu\" + value.upprMenuSn).find('a').eq(0).css({'position':'relative','color':'#2774ba'});\r\n\t\t\t\t\t\t\t\t} else {\r\n\t\t\t\t\t\t\t\t\tstr += \"<li id='menu\"+value.menuSn+\"'>\";\r\n\t\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t\tif(value.menuBsUrlAdrs == \"/webportal/minwon/rqs/rntCntrctStmntHist/rntCntrctStmntHistRgstView.do\"){\r\n\t\t\t\t\t\t\t\t\tstr += \"<a href=\\\"\"+value.menuBsUrlAdrs+\"\\\" style='padding: 9px 6px 5px 10px;' >\"+value.menuNm+\"</a>\";\r\n\t\t\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\t\t\tstr += \"<a href=\\\"\"+value.menuBsUrlAdrs+\"\\\">\"+value.menuNm+\"</a>\";\r\n\t\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\tstr += \"</li>\";\r\n\t\t\t\t\t\t\t\t$(\"#menu\"+value.upprMenuSn+\" > ul\").append(str);\r\n\t\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\t\tif(value.menuBsUrlAdrs == gPathName) $(\"#menu\"+value.upprMenuSn).addClass('on');\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}else if(value.level == 4){\r\n\t\t\t\t\t\t\tif( value.menuBsUrlAdrs == gPathName ) {\r\n\t\t\t\t\t\t\t\t$(\"#menu\" + value.upprMenuSn).addClass('on');\r\n\t\t\t\t\t\t\t\t$(\"#menu\" + value.upprMenuSn).parents().children('a').addClass('on');\r\n\t\t\t\t\t\t\t\t$(\"#menu\" + value.upprMenuSn).parents().children('a').css({'position':'relative','color':'#2774ba'});\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t});\r\n\t\t\t\t\t\r\n\t\t\t\t\tif(gPathName == '/webportal/minwon/rqs/rntcntrctcngstmnt/openRntCntrctCngStmntInsert.do'){\r\n\t\t\t\t\t\t$(\"#menu20000347\").addClass('on');\r\n\t\t\t\t\t\t$(\"#menu20000346\").find('a').eq(0).addClass('on');\r\n\t\t\t\t\t}\r\n\t\t\t\t\t \r\n\t\t\t\t\tstr = \"\";\r\n\t\t\t\t\tstr += \"<div class='banner'>\";\r\n\t\t\t        str += \"<ul>\";\r\n\t\t\t        str += \"<li><a href='/webportal/cont/cvplInfGdncView.open' title='바로가기'><img src='/resources/images/@sample_banner.png' width='216' height='70' alt='임대등록시스템 이용안내'></a></li>\";\r\n\t\t\t        str += \"<li><a href='/webportal/cont/rgstBenefitGdncView.open' title='바로가기'><img src='/resources/images/@sample_banner2.png' width='216' height='70' alt='임대등록의 다양한 혜택'></a></li>\";\r\n\t\t\t        str += \"</ul>\";\r\n\t\t\t        str += \"</div>\";\r\n\t\t\t        $(\".lnb\").append(str);\r\n\t\t\t\t\t\r\n\t\t\t    \t$(\".lnb > ul > li > a\").on('click',function() {\r\n\t\t\t    \t\tif($(this).parent().children(\"ul\").length) {\r\n\t\t\t    \t\t\t$(this).parent().siblings().children(\"a\").removeClass(\"on\");\r\n\t\t\t    \t\t\t$(this).addClass(\"on\");\r\n\t\t\t    \t\t}\r\n\t\t\t    \t});\r\n\t\t\t\t}\r\n\t\t\t});\r\n\t\t});\r\n\t \r\n</script>\r\n\r\n<!-- Sub menu -->\r\n<div class=\"lnb\">\r\n    \r\n</div>\r\n<!-- //Sub menu -->\n\t\t\t<!-- content -->\n\t\t\t<div id=\"section\" class=\"section\">\n\t\t\t\t\n\n\n\n\n<!-- 말줄임표 사용을 위한 css -->\n<!-- <style>\n.ellipsis {\n    text-overflow: ellipsis;\n    -o-text-overflow: ellipsis;\n    overflow: hidden;\n    white-space: nowrap;\n    word-wrap: normal !important;\n    /* display: block; */\n}\n</style>\t/* 2019.01.02 Row 틀어짐 제거 */\n -->\n\n<script type=\"text/javascript\">\n\t\n\t$(document).ready(function(){\t\t\n\t\tif($('#parameters').val()){\n\t\t\tvar o = JSON.parse($('#parameters').val().replace(/&amp;quot;/g, '\"'));\n\n\t\t\t$(\"#frmList\").initParameters(o);\n\n\t\t\tfn_selectList(o.currentPage);\n\t\t}else{\n\t\t\tfn_selectList(1);\n\t\t}\t\t\n\t})\n\n\t// 민원법정서식 목록을 가져오는 함수\n\tfunction fn_selectList(page) {\t\n\t\n\t\t$(\"#page\").val(page);\n\t\t\n\t\t$.ajax({\n\t\t\turl: '/webportal/bbs/frmtDownload/selectFrmtDownloadList.open',\n\t\t\tdata: JSON.stringify($(\"#frmList\").serializeFormJSON()),\n\t\t\tsuccess:function(res){\n\t\n\t\t\t\t$('#selectFrmtDownloadListTotalCnt').html(res.selectFrmtDownloadListTotalCnt); \n\t\t\t\t\n\t\t\t\t/* 민원법정서식의 가져온 내용을 테이블에 담음*/\n\t\t\t\t$('#mytable > tbody').empty();\n\t\t\t\tif(res.selectFrmtDownloadListTotalCnt==0){\n\t\t\t\t\t$(\"#frmtDownloadTemplate1\").tmpl().appendTo(\"#mytable > tbody\");\n\t\t\t\t}else{\n\t\t\t\t\t$(\"#frmtDownloadTemplate\").tmpl(res.list).appendTo(\"#mytable > tbody\");\n\t\t\t\t}\n\t\t\t\t\n\t\t\t\t$('#pagination').twbsPagination('destroy');\n\t\t\t\t $('#pagination').twbsPagination({\n\t\t\t\t\t \ttotalPages: res.totalPage,\n\t\t\t\t\t  \tstartPage: page,\n\t\t\t            onPageClick: function (event, page) {\n\t\t\t           \n\t\t\t               fn_selectList(page);\n\t\t\t           \t}\n\t\t\t       });\n\t\t\t\t\tif(parseInt(res.totalPage) <= 10){\n\t\t\t\t\t\t$(\"li.page-item.next, li.page-item.prev, li.page-item.last, li.page-item.first\").hide();\n\t\t\t\t\t}else{\n\t\t\t\t\t\t$(\"li.page-item.next, li.page-item.prev, li.page-item.last, li.page-item.first\").show();\n\t\t\t\t\t}\n\t\t\t}\n\t\t});\n\t\t\n\t}\n\t\n\t\n\t//파일 다운로드\n\tfunction fn_frmtDownloadFile(extsnNm, atchFilNo) {\n\t\t$.ajax({\n\t\t\tmethod : \"POST\",\n\t\t\tasync : false,\n\t\t\turl: '/webportal/bbs/frmtDownload/selectFrmtExtsn.open',\n\t\t\tdata: JSON.stringify({atchFilNo : atchFilNo, extsnNm : extsnNm}),\n\t\t\tsuccess:function(res){\n\t\t\t\t\n\t\t\t\tif(atchFilNo==null){\n\t\t\t\t\talert(\"파일이 없습니다!\");\n\t\t\t\t}else{\n\t\t\t\t\tvar filSrno = res.downloadExtsn.filSrno;\n\t\t\t\t\tif(filSrno != null){\n\t\t\t\t\t\tdownloadFile(atchFilNo,filSrno);\n\t\t\t\t\t}else{\n\t\t\t\t\t\tif(extsnNm == \"hwp\"){\n\t\t\t\t\t\t\talert(\"hwp 파일이 존재하지 않습니다.\");\n\t\t\t\t\t\t}else if(extsnNm == \"pdf\"){\n\t\t\t\t\t\t\talert(\"pdf 파일이 존재하지 않습니다.\");\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t},\n\t\t});\n\t}\n\t\n\t//민원법정서식 상세화면으로 이동\n\tfunction fn_frmtDownloadDetail(lglFrmtNo,atchFilNo){\n\t\tvar Params = {\"lglFrmtNo\":lglFrmtNo, \"atchFilNo\":atchFilNo};\n\t\tvar returnParams ={\n\t\t\t\t\t\t\ttxtSubjectSearch: $('#txtSubjectSearch').val(),\n\t\t\t\t\t\t\tcurrentPage: $('#pagination').twbsPagination('getCurrentPage')}\n\t\t\n\t\tpost('frmtDownloadDetail.open',Params,returnParams);\n\t\t//frmDetail.submit();\n\t}\n</script>\n\n<!-- tr,td 테이블-->\n<!-- frmtDownloadContainer에 값이 담기도록 하기위한 테이블 틀-->\n<script type=\"text/x-jQuery-tmpl\" id=\"frmtDownloadTemplate\">\n\t<tr align=\"center\">\t\t\n\t\t<td>{{= rnum}}</td>\n\t\t<td class=\"align-left ellipsis\"><a href=\"javascript:fn_frmtDownloadDetail('{{= lglFrmtNo}}','{{= atchFilNo}}')\">{{= sjNm}}</td>\n\t\t<td><a href=\"javascript:fn_frmtDownloadFile('hwp', '{{= atchFilNoDec}}')\"><i class=\"sp-ico ico-file\" style=\"margin: 3px 0 0 15px !important; width:23px !important;\"><em class=\"hide\">파일</em></i></a>\n\t\t\t<a href=\"javascript:fn_frmtDownloadFile('pdf', '{{= atchFilNoDec1}}')\"><i class=\"sp-ico ico-file\" style=\"margin: 3px 0 0 15px !important; width:23px !important;\"><em class=\"hide\">파일</em></i></a>\n\t\t</td>\n\t</tr>\n</script>\n\n<!-- 데이터가 없을 경우-->\n<script type=\"text/x-jQuery-tmpl\" id=\"frmtDownloadTemplate1\">\n\t<tr align=\"center\">\t\t\n\t\t<td colspan=3 align=\"center\">등록된 데이터가 없습니다.</td>\n\t</tr>\n</script>\n\n<!-- 상세검색 화면으로 이동 하기위한 폼-->\n<!-- <form id=\"frmDetail\" name=\"frmDetail\" method=\"post\" action=\"frmtDownloadDetail.do\">\n\t<input type=\"hidden\" id=\"lglFrmtNo\" name=\"lglFrmtNo\">\n\t<input type=\"hidden\" id=\"atchFilNo\" name=\"atchFilNo\">\n</form> -->\n\n\n<form id=\"frmList\" name=\"frmList\" method=\"post\" onsubmit=\"return false\">\n\t<input type=\"hidden\" id=\"page\" name=\"page\">\n\t<ul class=\"page-guide\">\n        <li><a href=\"/webportal/main/portalMainList.open\">홈</a><i class=\"sp-ico guide-arr\"><em class=\"hide\">></em></i></li>\n        <li><a href=\"/webportal/bbs/notice/selectPbNoticeList.open\">알림마당</a><i class=\"sp-ico guide-arr\"><em class=\"hide\">></em></i></li>\n        <li class=\"bold\">민원법정서식</li>\n    </ul>\n    <p class=\"page-title\">민원법정서식</p>\n    <p class=\"page-sub-title\">민원법정서식을 관리합니다.</p>\n    <div class=\"box-group half mg-t38 mg-l0\">\n        <div class=\"box\">\n            <div class=\"inr\">\n                <div class=\"search-count\">\n                    총 <span id=\"selectFrmtDownloadListTotalCnt\" class=\"color-orange\"></span>건\n                </div>\n            </div>\n        </div>\n        <div class=\"box\">\n            <div class=\"inr mg-l0\">\n                <div class=\"box-group half mg-l0\">\n                    <div class=\"box float-r\">\n                        <div class=\"inr mg-l0\">\n                            <div class=\"box-group join right mg-l0\">\n                                <div class=\"box\">\n                                    <div class=\"inr\">\n                                        <input type=\"text\" id=\"txtSubjectSearch\" name=\"txtSubjectSearch\" onkeypress=\"if(event.keyCode==13){fn_selectList(1);}\" title=\"검색값 등록\" placeholder=\"서식명\">\n                                    </div>\n                                </div>\n                                <div class=\"box-group-join\">\n                                    <div class=\"btn-group\">\n                                        <button type=\"button\"  onclick=\"fn_selectList(1)\" id=\"btnSearchList\" class=\"btn btn-type14\">검색</button>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>   \n    <div class=\"table-group board list mg-t10\">\n        <table id=\"mytable\">\n            <caption>민원법정서식 관리 목록</caption>\n            <colgroup>\n                <col style=\"width:75px\">\n                <col style=\"width:600px\">\n                <col>\n            </colgroup>\n            <thead>\n                <th>번호</th>\n                <th>민원서식(개정일)</th>\n                <th>HWP&emsp;PDF</th>\n            </thead>\n           \t<tbody>\t\n\t\t\t</tbody>\n        </table>\n     </div>\n     <div class=\"page-group\">\n\t\t<ul id=\"pagination\" class=\"pagination-sm\" ></ul>\n     </div>\n</form>\t\n\t\t\t</div>\n\t\t\t<!-- //content -->\n\t\t</div>\n\t\t<!-- //content_container -->\n\t\t\r\n\r\n        <!-- 하단 -->\r\n        <div id=\"footer\">\r\n        \t<div class=\"footer-group\">\r\n                <div class=\"bottom-menu\">\r\n                    <ul>\r\n                        <li><a href=\"/webportal/cont/UseStplatView.open\">이용약관</a></li>\r\n                        <li><a href=\"/webportal/cont/indvdlinfoPrcsPolcyView.open\"><span style=\"color:#ffff40;font-weight: bold;text-decoration:underline;\">개인정보처리방침</span></a></li>\r\n                        <li><a href=\"/webportal/cont/emailWtrmsClctRjctView.open\">이메일 무단수집 거부</a></li>\r\n                        <!-- <li><a href=\"http://stat.molit.go.kr/portal/quality/qualityCenterWrite.do?system_id=S0015\" title=\"품질오류신고\" target=\"_blank\">품질오류신고</a></li> -->\r\n                        <li><a href=\"https://data.molit.go.kr/systemQuality/list?system_id=S0015\" title=\"품질오류신고 및 확인\" target=\"_blank\">품질오류신고 및 확인</a></li>\r\n                    </ul>\r\n                </div>\r\n                <p class=\"text\"><span class=\"hide\">주소 : </span>국토교통부 (30103) 세종특별자치시 도움6로 11  /  한국토지주택공사 (52852)  경상남도 진주시 충의로 19</p>\r\n                <p class=\"copyright\">Copyright(C) <span>국토교통부 &amp; 한국토지주택공사</span> All rights reserved</p>\r\n            </div>\r\n        </div>\r\n        <!-- //하단 -->\n\t</div>\n\t<!-- //warp -->\n</body>\n</html>",
